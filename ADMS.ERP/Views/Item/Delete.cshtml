@model ADMS.ERP.Models.Item
@{
    ViewData["Title"] = "Delete Item";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">🗑 Delete Item</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <strong>Warning!</strong> Are you sure you want to delete this item?
                    This action cannot be undone.
                </div>

                @if (Model.ChildItems.Any())
                {
                    <div class="alert alert-danger">
                        <strong>Cannot delete!</strong> This item has @Model.ChildItems.Count child item(s).
                        Please delete the child items first.
                    </div>
                }

                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-4">Weight</dt>
                    <dd class="col-sm-8">@Model.Weight.ToString("F4") kg</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8 text-muted">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsProcessed)
                        {
                            <span class="badge bg-success">Processed</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Unprocessed</span>
                        }
                    </dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-3">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        @if (!Model.ChildItems.Any())
                        {
                            <button type="submit" class="btn btn-danger">
                                🗑 Yes, Delete
                            </button>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
