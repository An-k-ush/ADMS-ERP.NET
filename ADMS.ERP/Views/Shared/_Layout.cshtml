<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ADMS ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ADMS.ERP.styles.css" asp-append-version="true" />
    <style>
        .tree ul { list-style: none; padding-left: 1.5rem; }
        .tree li { position: relative; padding: 0.25rem 0; }
        .tree li::before { content: "├─ "; color: #6c757d; }
        .tree > ul > li::before { content: ""; }
        .badge-processed { background-color: #28a745; }
        .badge-unprocessed { background-color: #6c757d; }
        .navbar-brand { font-weight: bold; color: #0d6efd !important; }
        .sidebar-nav .nav-link { color: #495057; border-radius: 0.375rem; }
        .sidebar-nav .nav-link:hover, .sidebar-nav .nav-link.active { background-color: #e9ecef; color: #0d6efd; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Item" asp-action="Index">
                    🏭 ADMS ERP
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Item" asp-action="Index">📦 Items</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Process" asp-action="Create">⚙️ Process Item</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Process" asp-action="Index">📋 Processed Items</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Process" asp-action="Tree">🌲 Item Tree</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" data-bs-toggle="dropdown">
                                    👤 @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container text-center">
            &copy; 2026 - ADMS ERP .NET MVC Application
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
