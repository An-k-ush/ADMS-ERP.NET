@model ADMS.ERP.Models.TreeNodeViewModel
@{
    ViewData["Title"] = "Item Tree - " + Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">🌲 Item Tree: <strong>@Model.Name</strong></h2>
    <a asp-action="Tree" class="btn btn-outline-secondary btn-sm">← Full Tree</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="tree">
            @await Html.PartialAsync("_TreeNode", Model)
        </div>
    </div>
</div>

<div class="mt-3 small text-muted">
    <span class="badge bg-success me-1">●</span> Processed &nbsp;
    <span class="badge bg-secondary me-1">●</span> Unprocessed
</div>

@section Scripts {
    <script>
        function toggleTree(id) {
            var el = document.getElementById('subtree-' + id);
            if (el) {
                el.style.display = el.style.display === 'none' ? '' : 'none';
            }
        }
    </script>
}
