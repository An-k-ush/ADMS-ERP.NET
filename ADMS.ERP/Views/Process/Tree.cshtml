@model List<ADMS.ERP.Models.TreeNodeViewModel>
@{
    ViewData["Title"] = "Item Tree Structure";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">🌲 Item Tree Structure</h2>
    <a asp-controller="Item" asp-action="Create" class="btn btn-outline-primary btn-sm">+ Add Item</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted fs-5">No items found. The tree is empty.</p>
        <a asp-controller="Item" asp-action="Create" class="btn btn-primary">Add your first item</a>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="tree">
                @foreach (var root in Model)
                {
                    @await Html.PartialAsync("_TreeNode", root)
                }
            </div>
        </div>
    </div>

    <div class="mt-3 small text-muted">
        <span class="badge bg-success me-1">●</span> Processed &nbsp;
        <span class="badge bg-secondary me-1">●</span> Unprocessed
    </div>
}

@section Scripts {
    <script>
        function toggleTree(id) {
            var el = document.getElementById('subtree-' + id);
            if (el) {
                el.style.display = el.style.display === 'none' ? '' : 'none';
            }
        }
    </script>
}
